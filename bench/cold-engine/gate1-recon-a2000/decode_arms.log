# decode_arms.py — RTX A2000 12GB, torch 2.8.0+cu128, triton 3.4.0
# gnf4 native AVX2 + OpenMP. Three runs, in the order they were made.

########################################################################
# RUN 1 — DISCARDED. The control carried its own NVMe population, so
# cold_dest also changed the destination of experts nobody moved. Kept
# because the confound is the point: same error class as #171, one
# level up, and the 0.1068/0.1129 below are the probe's, not the tier's.
########################################################################
layers=8 experts=32 k=4 steps=128  movers=4/layer (32 of 256 cells)

offload_thin_uniq=None
 force_cold_mass(source='dram')          max|dlogit|   tokensfirstdiv
  cold_dest='gpu'  (cold rows 202095/0)      3.4570    False     15
  cold_dest='cpu'  (cold rows 0/202162)      0.1068     True   None
  control self-pair                       0.0000     True   None

 force_cold_mass(source='vram')          max|dlogit|   tokensfirstdiv
  cold_dest='gpu'  (cold rows 205779/0)      0.0000     True   None
  cold_dest='cpu'  (cold rows 0/205438)      0.1129     True   None
  control self-pair                       0.0000     True   None

offload_thin_uniq=4
 force_cold_mass(source='dram')          max|dlogit|   tokensfirstdiv
  cold_dest='gpu'  (cold rows 202006/0)      0.1121     True   None
  cold_dest='cpu'  (cold rows 0/202162)      0.1067     True   None
  control self-pair                       0.0000     True   None

 force_cold_mass(source='vram')          max|dlogit|   tokensfirstdiv
  cold_dest='gpu'  (cold rows 205779/0)      0.0000     True   None
  cold_dest='cpu'  (cold rows 0/205438)      0.1129     True   None
  control self-pair                       0.0000     True   None


