  cold_dest='gpu'  (cold rows 21408/0)      0.0683     True   None
  cold_dest='cpu'  (cold rows 0/21504)      0.0000     True   None

 force_cold_mass(source='vram')          max|dlogit|   tokensfirstdiv
  cold_dest='gpu'  (cold rows 23257/0)      0.0000     True   None
  cold_dest='cpu'  (cold rows 0/23338)      0.0676     True   None

