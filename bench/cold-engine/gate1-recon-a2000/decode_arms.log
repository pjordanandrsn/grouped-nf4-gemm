########################################################################
# RUN 2 — control with an EMPTY NVMe tier (the gate-1 control shape),
# wide DRAM population (24 -> 20 after the move). offload_thin_uniq
# cannot engage in either arm, so this isolates cold_dest alone.
########################################################################
layers=8 experts=32 k=4 steps=96  movers=4/layer (32 of 256 cells)

offload_thin_uniq=None
 control self-pair                        0.0000     True

