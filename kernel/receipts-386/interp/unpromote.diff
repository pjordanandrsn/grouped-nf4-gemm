-        row = tl.load(tbl_ptr + slot * bps + blk).to(tl.int64)
+        row = tl.load(tbl_ptr + slot * bps + blk)
         pay = row * row_bytes + fill * (H * D) + h * D
         sc = (row * row_bytes + pay_bytes
               + (fill * (H * GROUPS) + h * GROUPS) * 4)
